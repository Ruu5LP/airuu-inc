# 関数＆再帰の例
ガチ勢 kaijo(n) {
    ワンチャン (n <= 1) {
        もどす 1な
    }
    もどす n * kaijo(n - 1)な
}

ガチ勢 saikyo(a, b) {
    ワンチャン (a > b) {
        もどす aな
    }
    もどす bな
}

あげぽよ(kaijo(5))な
あげぽよ(saikyo(3, 9))な

ワンチャン (kaijo(4) == 24 かつ saikyo(3, 9) == 9) {
    あげぽよ("それな、完璧")な
} それな {
    あげぽよ("あれ、なんか違う")な
}
