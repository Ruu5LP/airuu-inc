# ギャル語FizzBuzz（1〜20）
うちのiは1な
ぐるぐる (i <= 20) {
    ワンチャン (i % 15 == 0) {
        あげぽよ("フィズバズぴょん")な
    } それな {
        ワンチャン (i % 3 == 0) {
            あげぽよ("フィズぅ")な
        } それな {
            ワンチャン (i % 5 == 0) {
                あげぽよ("バズよ")な
            } それな {
                あげぽよ(i)な
            }
        }
    }
    iはi + 1な
}
